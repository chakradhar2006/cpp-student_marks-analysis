
#Key Features

#• Data Input: Takes the total number of students and records their marks.
#• Class Statistics: Calculates total marks, class average, highest score, and lowest score.
#• Search Tool: Scans the data to find which student achieved a specific score.
#• Grade Sorting: Uses a bubble sort algorithm to arrange and display marks in ascending order.

#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter number of students: ";
    cin >> n;
    int marks[n];

    // Input marks
    cout << "\nEnter marks of " << n << " students:\n";
    for (int i = 0; i < n; i++) {
        cout << "Student " << i + 1 << ": ";
        cin >> marks[i];
    }

    // Display marks
    cout << "\n--- Student Marks ---\n";
    for (int i = 0; i < n; i++) {
        cout << "Student " << i + 1 << ": " << marks[i] << endl;
    }

    // Calculate sum, maximum and minimum
    int sum = 0;
    int maximum = marks[0];
    int minimum = marks[0];

    for (int i = 0; i < n; i++) {
        sum += marks[i];
        if (marks[i] > maximum) {
            maximum = marks[i];
        }
        if (marks[i] < minimum) {
            minimum = marks[i];
        }
    }

    float average = (float)sum / n;

    cout << "\n--- Analysis ---\n";
    cout << "Total Marks = " << sum << endl;
    cout << "Average Marks = " << average << endl;
    cout << "Highest Marks = " << maximum << endl;
    cout << "Lowest Marks = " << minimum << endl;

    // Search for a mark
    int searchMark;
    bool found = false;
    cout << "\nEnter marks to search: ";
    cin >> searchMark;

    for (int i = 0; i < n; i++) {
        if (marks[i] == searchMark) {
            cout << "Marks found at Student " << i + 1 << endl;
            found = true;
        }
    }
    if (!found) {
        cout << "Marks not found.\n";
    }

    // Sort marks in ascending order
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (marks[j] > marks[j + 1]) {
                int temp = marks[j];
                marks[j] = marks[j + 1];
                marks[j + 1] = temp;
            }
        }
    }

    cout << "\n--- Marks in Ascending Order ---\n";
    for (int i = 0; i < n; i++) {
        cout << marks[i] << " ";
    }
    cout << endl;

    return 0;
}
